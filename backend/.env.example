PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Required for account delete + auth emails (signup / password reset links)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
# Optional: hiring messages always go to the candidate Inbox. Set these to also email them.
# Also used for signup / password-reset emails (Supabase built-in mail only reaches team members)
RESEND_API_KEY=re_xxxxxxxx
# Test sender (only delivers to your Resend account email). Or use noreply@your-verified-domain.com
RESEND_FROM=Elevate <beth.t@example.com>
# Groq API key for AI resume screening + interview questions
GROQ_API_KEY=your_groq_api_key
# Optional: auto-create Google Meet links when scheduling interviews
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
# Then run: node scripts/google-meet-auth.js
# Optional: node scripts/seed-admin.js admin@elevate.local AdminPass123
